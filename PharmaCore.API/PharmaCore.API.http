POST {{baseUrl}}/purchases/1/items
Content-Type: application/json

{
  "medicineId": 1,
  "batchNumber": "BATCH-001",
  "quantity": 100,
  "purchasePrice": 5.00,
  "sellPrice": 10.00,
  "expireDate": "2027-12-31"
}

