@baseUrl = http://localhost:5084

### Health check
GET {{baseUrl}}/health

### Get enums
GET {{baseUrl}}/enums

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "admin"
}

### Get current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### List categories
GET {{baseUrl}}/categories?page=1&limit=20

### Get category by ID
GET {{baseUrl}}/categories/1

### Create category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "categoryName": "Antibiotics",
  "categoryArabicName": "مضادات حيوية"
}

### Update category
PUT {{baseUrl}}/categories/1
Content-Type: application/json

{
  "categoryName": "Updated Name",
  "categoryArabicName": "اسم محدث"
}

### Delete category
DELETE {{baseUrl}}/categories/1

### List deleted categories
GET {{baseUrl}}/categories/deleted

### Restore category
POST {{baseUrl}}/categories/1/restore

### Hard delete category
DELETE {{baseUrl}}/categories/1/hard

### List customers
GET {{baseUrl}}/customers?page=1&limit=20

### Get customer by ID
GET {{baseUrl}}/customers/1

### Create customer
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "name": "John Doe",
  "phoneNumber": "01001234567",
  "address": "Cairo",
  "note": "Regular customer"
}

### Update customer
PUT {{baseUrl}}/customers/1
Content-Type: application/json

{
  "name": "John Doe",
  "phoneNumber": "01001234567",
  "address": "Cairo",
  "note": "Updated note"
}

### Delete customer
DELETE {{baseUrl}}/customers/1

### Customer sales
GET {{baseUrl}}/customers/1/sales

### Customer debt
GET {{baseUrl}}/customers/1/debt

### Customer unpaid sales
GET {{baseUrl}}/customers/1/unpaid-sales

### Customer statement
GET {{baseUrl}}/customers/1/statement

### Pay customer debt
POST {{baseUrl}}/customers/1/pay
Content-Type: application/json

{
  "amount": 100.00,
  "method": "Cash",
  "description": "Partial payment"
}

### List medicines
GET {{baseUrl}}/medicines?page=1&limit=20

### Get medicine by ID
GET {{baseUrl}}/medicines/1

### Create medicine
POST {{baseUrl}}/medicines
Content-Type: application/json

{
  "name": "Amoxicillin",
  "arabicName": "أموكسيسيلين",
  "barcode": "123456789",
  "categoryId": 1,
  "unit": "Box"
}

### Update medicine
PUT {{baseUrl}}/medicines/1
Content-Type: application/json

{
  "name": "Amoxicillin 500mg",
  "arabicName": "أموكسيسيلين 500",
  "barcode": "123456789",
  "categoryId": 1,
  "unit": "Box"
}

### Delete medicine
DELETE {{baseUrl}}/medicines/1

### Search medicines
GET {{baseUrl}}/medicines/search?q=amox

