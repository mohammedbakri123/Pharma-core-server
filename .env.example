# PharmaCore Backend - Environment Configuration Template
# Copy this file to '.env' and fill in your real values.
# IMPORTANT: Never commit '.env' to your repository.

# Database Connection (PostgreSQL)
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
ConnectionStrings__Default="Host=localhost;Port=5432;Database=pharma_core;Username=pharmacore_app;Password=replace-with-a-strong-password"

# Security (JWT)
# Must be a random non-placeholder value with at least 32 characters.
Jwt__SecretKey="replace-with-at-least-32-random-characters"

# Optional overrides
# ASPNETCORE_ENVIRONMENT=Development
